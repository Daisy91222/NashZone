{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NashZone Day 1 contracts",
  "$ref": "#/$defs/input",
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "kind", "title", "captured_at", "effective_date"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["user_transcription", "official_web", "uploaded_document"]},
        "title": {"type": "string"},
        "url": {"type": ["string", "null"]},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "effective_date": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["id", "value", "unit", "source_id", "status"],
      "properties": {
        "id": {"type": "string"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "source_id": {"type": "string"},
        "status": {"enum": ["user_provided", "verified", "unresolved"]},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["origin", "uses"],
      "properties": {
        "origin": {"enum": ["user", "system_proposed"]},
        "uses": {"type": "array", "items": {"type": "string"}},
        "height_ft": {"type": ["number", "null"], "minimum": 0},
        "gross_area_sf": {"type": ["number", "null"], "minimum": 0},
        "units": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "section", "physical_page", "printed_page", "excerpt"],
      "properties": {
        "source_id": {"type": "string"},
        "section": {"type": ["string", "null"]},
        "physical_page": {"type": ["integer", "null"], "minimum": 1},
        "printed_page": {"type": ["string", "null"]},
        "excerpt": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "topic", "text", "kind", "applicability", "evidence", "relationships", "review_status"],
      "properties": {
        "id": {"type": "string"},
        "topic": {"type": "string"},
        "text": {"type": "string"},
        "kind": {"enum": ["mandatory", "advisory", "incentive", "definition", "unresolved"]},
        "applicability": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "relationships": {"type": "array", "items": {
          "type": "object", "required": ["target_rule_id", "relationship", "evidence"],
          "properties": {
            "target_rule_id": {"type": "string"},
            "relationship": {"enum": ["overrides", "supplements", "exempts", "conflicts", "references"]},
            "evidence": {"$ref": "#/$defs/evidence"}
          }, "additionalProperties": false
        }},
        "review_status": {"enum": ["extracted", "reviewed", "unresolved"]}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "topic", "statement", "status", "rule_ids", "fact_ids", "applicability_rationale", "missing_inputs", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "topic": {"type": "string"},
        "statement": {"type": "string"},
        "status": {"enum": ["supported", "conditional", "unresolved", "not_applicable"]},
        "rule_ids": {"type": "array", "items": {"type": "string"}},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "applicability_rationale": {"type": "string"},
        "missing_inputs": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "supported"}}}, "then": {"properties": {"evidence": {"minItems": 1}, "rule_ids": {"minItems": 1}}}}],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["schema_version", "jurisdiction_id", "parcel_id", "mode", "interested_uses", "scenario", "sources", "facts", "derived_checks", "open_questions"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "jurisdiction_id": {"type": "string"},
        "parcel_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["baseline", "scenario"]},
        "interested_uses": {"type": "array", "items": {"type": "string"}},
        "scenario": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scenario"}]},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
        "derived_checks": {"type": "array", "items": {
          "type": "object", "required": ["id", "formula", "result", "unit", "input_fact_ids", "status"],
          "properties": {
            "id": {"type": "string"}, "formula": {"type": "string"}, "result": {"type": "number"},
            "unit": {"type": "string"}, "input_fact_ids": {"type": "array", "items": {"type": "string"}},
            "status": {"const": "arithmetic_only_not_regulatory_area"}
          }, "additionalProperties": false
        }},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "baseline"}}}, "then": {"properties": {"scenario": {"type": "null"}}}},
        {"if": {"properties": {"mode": {"const": "scenario"}}}, "then": {"properties": {"scenario": {"$ref": "#/$defs/scenario"}}}}
      ],
      "additionalProperties": false
    }
  }
}
